              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Has items array and sources report\", () => { pm.expect(j.items).to.be.an(\"array\"); pm.expect(j.sources).to.be.an(\"array\").that.is.not.empty; });",
                  "pm.test(\"Each source has a status\", () => j.sources.forEach(s => pm.expect([\"Live\",\"Cached\",\"Stale\",\"Failed\"]).to.include(s.status)));",
                  "pm.test(\"Response time under 20s\", () => pm.expect(pm.response.responseTime).to.be.below(20000));"
