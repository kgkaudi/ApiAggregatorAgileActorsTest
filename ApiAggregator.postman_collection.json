    {
      "name": "Caching",
      "description": "Run these two requests in order (or run the whole collection with the Collection Runner). The first uses a brand-new search term, so nothing can be cached yet. The second repeats it and asserts that every source that answered live is now served from the cache.",
      "item": [
        {
          "name": "1. Prime the cache (new unique term)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/aggregation?query={{cacheTerm}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "aggregation"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{{cacheTerm}}"
                }
              ]
            },
            "description": "Generates a unique search term (stored in {{cacheTerm}}) and remembers which sources answered Live."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cacheTerm', 'postman' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"A brand-new term is never served from cache\", () => j.sources.forEach(s => pm.expect(s.status).to.not.eql(\"Cached\")));",
                  "const live = j.sources.filter(s => s.status === \"Live\").map(s => s.source);",
                  "pm.collectionVariables.set(\"cacheLiveSources\", JSON.stringify(live));",
                  "pm.test(\"At least one source answered live\", () => pm.expect(live.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Same term again (served from cache)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/aggregation?query={{cacheTerm}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "aggregation"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{{cacheTerm}}"
                }
              ]
            },
            "description": "Must run right after request 1 (the cache lives for 2 minutes by default)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const live = JSON.parse(pm.collectionVariables.get(\"cacheLiveSources\") || \"[]\");",
                  "pm.test(\"Sources that were live a moment ago are now Cached with no API call\", () => {",
                  "  pm.expect(live, \"run request 1 first\").to.not.be.empty;",
                  "  live.forEach(name => {",
                  "    const s = j.sources.find(x => x.source === name);",
                  "    pm.expect(s, name + \" is reported\").to.exist;",
                  "    pm.expect(s.status, name + \" status\").to.eql(\"Cached\");",
                  "    pm.expect(s.durationMs, name + \" durationMs\").to.eql(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
