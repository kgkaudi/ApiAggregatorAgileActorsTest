{
  "info": {
    "name": "API Aggregator",
    "description": "Postman collection for the API Aggregator service.\n\n1. Start the API (`dotnet run --project src/ApiAggregator.Api`).\n2. Check the `baseUrl` collection variable (default http://localhost:5000).\n3. Run any request; a JWT is fetched automatically. Or run the whole collection with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login: fetch a JWT if we do not have one or it is about to expire.",
          "const exp = Date.parse(pm.collectionVariables.get('tokenExpiresAt') || '') || 0;",
          "if (pm.collectionVariables.get('token') && exp - Date.now() > 60000) { return; }",
          "pm.sendRequest({",
          "  url: pm.variables.replaceIn('{{baseUrl}}/api/auth/token'),",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({",
          "    username: pm.variables.replaceIn('{{username}}'),",
          "    password: pm.variables.replaceIn('{{password}}') }) }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.warn('Auto-login failed', err || res.code); return; }",
          "  const j = res.json();",
          "  pm.collectionVariables.set('token', j.accessToken);",
          "  pm.collectionVariables.set('tokenExpiresAt', j.expiresAt);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "username",
      "value": "demo"
    },
    {
      "key": "password",
      "value": "demo-password"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenExpiresAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Exchanges the demo credentials for a JWT. The token is stored in the {{token}} collection variable and used automatically by all other requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Returns bearer token\", () => { pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(j.tokenType).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"token\", j.accessToken);",
                  "pm.collectionVariables.set(\"tokenExpiresAt\", j.expiresAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get token - wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
