{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Aggregation": {
    "CacheDuration": "00:02:00",
    "FallbackCacheDuration": "01:00:00",
    "SourceTimeout": "00:00:15",
    "MaxItemsPerSource": 20
  },

  "Statistics": {
    "FastThresholdMs": 100,
    "AverageThresholdMs": 200,
    "SampleRetention": "00:15:00",
    "MaxSamplesPerApi": 10000
  },

  "AnomalyDetection": {
    "Enabled": true,
    "Interval": "00:01:00",
    "Window": "00:05:00",
    "DegradationThresholdPercent": 50,
    "MinimumSamples": 3
  },

  "Jwt": {
    "Issuer": "ApiAggregator",
    "Audience": "ApiAggregator.Clients",
    "SigningKey": "DEV-ONLY-change-me-this-key-must-be-at-least-32-chars",
    "ExpiryMinutes": 60
  },

  "Auth": {
    "Username": "demo",
    "Password": "demo-password"
  },

  "ExternalApis": {
    "GitHub": { "BaseUrl": "https://api.github.com/", "Token": "" },
    "HackerNews": { "BaseUrl": "https://hn.algolia.com/api/v1/" },
    "Wikipedia": { "BaseUrl": "https://en.wikipedia.org/w/" }
  }
}
